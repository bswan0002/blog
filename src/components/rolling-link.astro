---
import { ArrowRight } from "lucide-react"

interface Props {
  href: string
  label: string
  class?: string
}

const { href, label, class: className } = Astro.props
const letters = Array.from(new Intl.Segmenter(undefined, { granularity: "grapheme" }).segment(label), ({ segment }) => segment)
---

<a href={href} class:list={["rolling-link", className]}>
  <span class="sr-only">{label}</span>
  <span class="letters" aria-hidden="true">
    {letters.map((letter, index) => (
      <span class="letter" style={`--index: ${index}`}>
        <span class="letter-track">
          <span>{letter}</span>
          <span>{letter}</span>
        </span>
      </span>
    ))}
  </span>
  <ArrowRight size="0.75em" aria-hidden="true" focusable="false" />
</a>

<style>
  .rolling-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }

  .rolling-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: 2px;
  }

  .letters {
    display: flex;
  }

  .letter {
    height: 1.2em;
    overflow: hidden;
  }

  .letter-track {
    display: block;
    transform: translateY(-50%);
    transition: transform 350ms cubic-bezier(.22, 1, .36, 1);
    transition-delay: calc(var(--index) * 35ms);
  }

  .letter-track > span {
    display: block;
    line-height: 1.2;
    white-space: pre;
  }

  .rolling-link:focus-visible .letter-track {
    transform: translateY(0);
  }

  @media (hover: hover) {
    .rolling-link:hover .letter-track {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rolling-link .letter-track {
      transform: translateY(-50%);
      transition: none;
    }
  }
</style>
