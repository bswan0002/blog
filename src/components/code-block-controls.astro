---
import { WrapText, Copy, Check } from "lucide-react"
import { Button } from "@/components/ui/button"
---

<script is:inline>
  try {
    document.documentElement.dataset.codeWrap =
      localStorage.getItem("code-wrap") === "false" ? "false" : "true"
  } catch {
    document.documentElement.dataset.codeWrap = "true"
  }
</script>

<template id="code-block-toolbar">
  <div class="code-block-toolbar not-typeset" role="group" aria-label="Code block controls">
    <Button variant="ghost" size="icon-sm" className="aria-pressed:bg-muted aria-pressed:text-foreground" type="button" data-code-wrap aria-label="Wrap lines in all code blocks" aria-pressed="true" title="Disable line wrapping in all code blocks">
      <WrapText size={16} aria-hidden="true" />
    </Button>
    <Button variant="ghost" size="icon-sm" type="button" data-code-copy aria-label="Copy code" title="Copy code">
      <span data-copy-icon><Copy size={16} aria-hidden="true" /></span>
      <span data-copied-icon hidden><Check size={16} aria-hidden="true" /></span>
    </Button>
    <span class="sr-only" role="status" data-copy-status></span>
  </div>
</template>

<script>
  import "@/lib/code-block-controls"
</script>

<style is:global>
  .typeset .code-block {
    position: relative;
    min-inline-size: 0;
    margin-block-start: var(--typeset-flow);
  }

  .typeset .code-block > pre {
    margin-block-start: 0;
  }

  .typeset li > .code-block {
    margin-block-start: 0.5em;
  }

  .typeset .code-block-toolbar {
    position: absolute;
    inset-block-start: 0.375rem;
    inset-inline-end: 0.375rem;
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    pointer-events: none;
  }

  .code-block:hover .code-block-toolbar,
  .code-block:focus-within .code-block-toolbar {
    opacity: 1;
    pointer-events: auto;
  }

  @media (hover: none), (pointer: coarse) {
    .typeset .code-block-toolbar {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media print {
    .typeset .code-block-toolbar {
      display: none;
    }
  }
</style>
