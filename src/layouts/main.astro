---
import "@/styles/global.css"
import { ModeToggle } from "@/components/mode-toggle"
import { SiteBreadcrumb, type BreadcrumbEntry } from "@/components/site-breadcrumb"

interface Props {
  title?: string
  description?: string
  breadcrumbs?: BreadcrumbEntry[]
}

const { title = "Ben Swanson", description, breadcrumbs = [] } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const system = window.matchMedia("(prefers-color-scheme: dark)")
        const normalize = (value) =>
          value === "light" || value === "dark" ? value : "system"
        let preference = "system"
        try {
          preference = normalize(localStorage.getItem("theme"))
        } catch {
          // Storage may be unavailable in private or restricted contexts.
        }

        const apply = () => {
          const dark = preference === "dark" || (preference === "system" && system.matches)
          document.documentElement.classList.toggle("dark", dark)
          document.documentElement.style.colorScheme = dark ? "dark" : "light"
        }

        apply()
        system.addEventListener("change", apply)
        window.addEventListener("theme-change", (event) => {
          preference = normalize(event.detail)
          try {
            localStorage.setItem("theme", preference)
          } catch {
            // Theme changes still work without persistence.
          }
          apply()
        })
        window.addEventListener("storage", (event) => {
          if (event.key === "theme" || event.key === null) {
            preference = normalize(event.newValue)
            apply()
          }
        })
      })()
    </script>
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header id="site-header" class="sticky top-0 z-50 border-b bg-background py-4">
      <div class="mx-auto flex w-[calc(100%-2rem)] max-w-[640px] items-center justify-between gap-4">
        <SiteBreadcrumb items={breadcrumbs} />
        <ModeToggle client:load />
      </div>
    </header>
    <div class="mx-auto w-[calc(100%-2rem)] max-w-[640px]">
      <slot />
    </div>
  </body>
</html>

<style>
  #site-header {
    transform: translateY(0);
  }

  @media (width < 48rem) and (prefers-reduced-motion: no-preference) {
    #site-header {
      transition: transform 300ms var(--ease-out);
    }

    #site-header:focus-within {
      transition: none;
    }

    #site-header[data-hidden="true"]:not(:focus-within) {
      transform: translateY(-100%);
    }
  }
</style>

<script>
  const header = document.querySelector("#site-header")
  const main = document.querySelector("main")

  if (header instanceof HTMLElement && main instanceof HTMLElement) {
    const mobile = window.matchMedia("(width < 48rem)")
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
    const scrollPosition = () => Math.max(0, Math.min(
      window.scrollY,
      document.documentElement.scrollHeight - window.innerHeight,
    ))
    let previousY = scrollPosition()
    let cutoff = 0

    const show = () => {
      header.dataset.hidden = "false"
    }

    const measure = () => {
      // The sticky header already occupies its height in document flow.
      // Start hiding when the content's top padding has scrolled away.
      cutoff = parseFloat(getComputedStyle(main).paddingTop) || 0
      if (scrollPosition() <= cutoff) show()
    }

    const reset = () => {
      show()
      previousY = scrollPosition()
      measure()
    }

    window.addEventListener("scroll", () => {
      const y = scrollPosition()
      if (!mobile.matches || reducedMotion.matches || y <= cutoff
        || header.contains(document.activeElement)
        || header.querySelector('[aria-expanded="true"]')) {
        show()
      } else if (y !== previousY) {
        // Once the top padding is gone, direction alone controls visibility.
        header.dataset.hidden = String(y > previousY)
      }
      previousY = y
    }, { passive: true })

    // Keep keyboard navigation immediate, without animating focused controls.
    header.addEventListener("focusin", show)
    mobile.addEventListener("change", reset)
    reducedMotion.addEventListener("change", reset)
    window.addEventListener("resize", measure)
    window.addEventListener("pageshow", reset)
    const resizeObserver = new ResizeObserver(measure)
    resizeObserver.observe(header)
    resizeObserver.observe(main)
    reset()
  }
</script>
