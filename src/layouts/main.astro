---
import "@/styles/global.css"
import { SiteBreadcrumb, type BreadcrumbEntry } from "@/components/site-breadcrumb"

interface Props {
  title?: string
  description?: string
  breadcrumbs?: BreadcrumbEntry[]
}

const { title = "Ben Swanson", description, breadcrumbs = [] } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b bg-background py-4">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-[640px]">
        <SiteBreadcrumb items={breadcrumbs} />
      </div>
    </header>
    <div class="mx-auto w-[calc(100%-2rem)] max-w-[640px]">
      <slot />
    </div>
  </body>
</html>
